# App Configuration
PORT=80

# Database Configuration
DATABASE_URL=postgres://user:password@db:5432/activitylog
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=activitylog

# Sidecar Backup Configuration
BACKUP_INTERVAL_MINS=5
BACKUP_RETENTION_COUNT=5

## openssl rand -hex 32 (Your token to authorize the restore operation)
RESTORE_AUTH_TOKEN=change-me-to-a-secure-token
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Google Credentials (path relative to sidecar directory or absolute)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Google Credentials for production/container-only deployments
# Generate with:
#   base64 -w 0 sidecar/credentials.json
#   base64 -w 0 sidecar/token.json
GOOGLE_API_CREDENTIALS_B64=
GOOGLE_API_TOKEN_B64=
